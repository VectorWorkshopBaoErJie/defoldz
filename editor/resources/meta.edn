  {:type :boolean,
   :help "启用游戏内性能分析器",
   :default true,
   :label "性能分析器",  ; 新增标签
   :path ["profiler" "enabled"]}
  
  {:type :integer,
   :help "服务器更新间隔（毫秒）",
   :default 0,
   :label "分析器更新间隔",  ; 新增标签
   :path ["profiler" "sleep_between_server_updates"]}
  
  ;; 热更新配置
  {:type :resource,
   :filter "settings",
   :default "/liveupdate.settings",
   :help "热更新配置文件",
   :preserve-extension true,
   :label "热更新配置",  ; 新增标签
   :path ["liveupdate" "settings"]}
  
   
  ;; 最后三个配置项
  {:type :boolean
   :filter "settings"
   :default true
   :help "应用启动时自动挂载先前挂载的资源"
   :label "启动自动挂载"  ; 新增标签
   :path ["liveupdate" "mount_on_start"]}
  
  {:type :integer,
   :help "单个集合中最大并发瓦片地图数量",
   :default 16,
   :label "瓦片地图上限",  ; 新增标签
   :path ["tilemap" "max_count"]}
  
  {:type :integer,
   :help "单个集合中最大并发可见瓦片数量",
   :default 2048,
   :label "可见瓦片上限",  ; 新增标签
   :path ["tilemap" "max_tile_count"]}]
 
