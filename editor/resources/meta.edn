   :default true,
   :label "控制台横幅",  ; 新增标签
   :path ["html5" "show_console_banner"]}
  
  {:type :string,
   :help "Canvas缩放模式，默认为'Downscale Fit'",
   :default "downscale_fit",
   :label "缩放模式",  ; 新增标签
   :path ["html5" "scale_mode"]
   :options [["downscale_fit" "等比缩小适配"]
             ["fit" "等比适配"]
             ["stretch" "拉伸"]
             ["no_scale" "无缩放"]]}  ; 选项本地化
  
  {:type :integer,
   :help "文件下载失败时的重试次数",
   :default 10,
   :label "下载重试次数",  ; 新增标签
   :path ["html5" "retry_count"]}
  
  {:type :number,
   :help "文件加载失败后的重试间隔（秒）",
   :default 1.0,
   :label "重试间隔",  ; 新增标签
   :path ["html5" "retry_time"]}
  
  {:type :boolean,
   :help "设置图形上下文背景透明",
   :default false,
   :label "透明背景",  ; 新增标签
   :path ["html5" "transparent_graphics_context"]}
  
  ;; 原生扩展与性能分析
  {:type :resource,
   :filter "appmanifest",
   :preserve-extension true,
   :help "原生扩展配置文件（提供详细的构建设置控制）",
   :label "原生扩展清单",  ; 新增标签
   :path ["native_extension" "app_manifest"]}
  
  {:type :boolean,
   :help "在发布版本中启用CPU使用率采样",
