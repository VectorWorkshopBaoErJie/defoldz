   :default false,
   :label "WASM流式加载",  ; 新增标签
   :path ["html5" "wasm_streaming"]}
  
  {:type :boolean,
   :help "是否显示全屏按钮",
   :default true,
   :label "全屏按钮",  ; 新增标签
   :path ["html5" "show_fullscreen_button"]}
  
  {:type :boolean,
   :help "是否显示'Made with Defold'链接",
