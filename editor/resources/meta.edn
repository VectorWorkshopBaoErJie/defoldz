{:settings
 [{:type :string,
   :help "应用标题",
   :default "unnamed",
   :label "标题",
   :path ["project" "title"]}
  {:type :string,
   :help "应用版本",
   :default "1.0",
   :label "版本",
   :path ["project" "version"]}
  {:type :string,
   :help "发行商名称",
   :default "",
   :label "发行商"
   :path ["project" "publisher"]}
  {:type :string,
   :help "开发者名称",
   :default "",
   :label "开发者"
   :path ["project" "developer"]}
  {:type :boolean,
   :help "将日志信息写入磁盘",
   :default false,
   :label "记录日志",
   :path ["project" "write_log"]}
  {:type :string,
   :help "‌仅显示最低日志级别及更高级别的日志",
   :default "1",
   :label "最低日志级别",
   :path ["project" "minimum_log_level"]
   :options [["0" "DEBUG = 0"] ["1" "USER DEBUG = 1"] ["2" "INFO = 2"] ["3" "WARNING = 3"] ["4" "ERROR = 4"] ["5" "FATAL = 5"]]}
  {:type :boolean,
   :help "压缩制品，非安卓",
   :default true,
   :label "压缩制品",
   :path ["project" "compress_archive"]}
  {:type :list,
   :help
   "‌本项目所需依赖项目的 URL 列表，以逗号分隔",
   :label "依赖",
   :path ["project" "dependencies"]
   :element {:type :url
             :default "https://url.to/library"}}
  {:type :string,
   :help
   "项目资源包含列表，以逗号分隔。若指定目录，则该目录下的所有文件及子目录将被递归包含",
   :default "",
   :label "自定义资源",
   :path ["project" "custom_resources"]}
  {:type :string,
   :help
   "一个包含资源文件和文件夹的目录，在打包时被原样复制到结果包中。详见文档",
   :default "",
   :label "打包资源",
   :path ["project" "bundle_resources"]}
  {:type :string,
   :help
   "不应包含在打包产物中的资源列表，即被排除。以逗号分隔",
   :default "",
   :label "打包排除资源",
   :path ["project" "bundle_exclude_resources"]}
  {:type :resource,
   :filter "collection",
   :help
   "‌应用启动时使用的集合文件，默认为 /logic/main.collection",
   :default "/logic/main.collection",
   :label "启动集合",
   :path ["bootstrap" "main_collection"]}
  {:type :resource,
   :filter "render",
   :help
   "使用渲染文件定义渲染管线，默认为 /builtins/render/default.render",
   :default "/builtins/render/default.render",
   :label "渲染器",
   :path ["bootstrap" "render"]}
  {:type :resource,
   :filter "lua",
   :help ""
   :default "",
   :path ["bootstrap" "debug_init_script"]
   :hidden? true}
  {:type :string,
   :help "将此项目作为库使用时需要包含的目录",
   :default "",
   :label "库目录",
   :path ["library" "include_dirs"]}
  {:type :boolean,
   :help "所有脚本类型共享同一个 Lua 状态机",
   :default false,
   :label "共享状态",
   :path ["script" "shared_state"]}
  {:type :boolean,
   :help "允许窗口最小化时保持引擎运行，仅限桌面平台",
   :default false,
   :label "后台运行",
   :path ["engine" "run_while_iconified"]}
  {:type :integer,
   :help "允许部分组件使用固定帧率，0 表示禁用此功能，单位：赫兹",
   :default 60,
   :label "固定帧率",
   :path ["engine" "fixed_update_frequency"]}
  {:type :number,
   :help "若单帧时间过长，将被限制为此最大值，单位：秒",
   :default 0.5,
   :label "单帧最大时间",
   :path ["engine" "max_time_step"]}
  {:type :integer,
   :help
   "‌应用程序窗口宽度，默认为 960 像素",
   :default 960,
   :label "宽度",
   :path ["display" "width"]}
  {:type :integer,
   :help
   "应用程序窗口高度，默认为 640  像素",
   :default 640,
   :label "高度",
   :path ["display" "height"]}
  {:type :boolean,
   :help "‌在可用时启用高 DPI 后缓冲区",
   :default false,
   :label "高 DPI",
   :path ["display" "high_dpi"]}
  {:type :integer,
   :help
   "‌超采样抗锯齿 SSAA 的采样数设置，默认为 0 ，表示关闭该功能",
   :default 0,
   :path ["display" "samples"]}
  {:type :boolean,
   :help
   "以全屏模式启动应用程序",
   :default false,
   :label "全屏",
   :path ["display" "fullscreen"]}
  {:type :resource,
   :filter "display_profiles",
   :help
   "此应用所使用的显示配置文件",
   :default "/builtins/render/default.display_profiles",
   :label "显示配置",
   :path ["display" "display_profiles"]}
  {:type :boolean,
   :help "‌动态屏幕方向支持",
   :default false,
   :label "动态方向",
   :path ["display" "dynamic_orientation"]}
  {:type :integer,
   :help "‌游戏主循环每秒更新次数。设为 0 表示可变帧率，设为 30 则限制更新频率",
   :default 0,
   :label "刷新率",
   :path ["display" "update_frequency"]}
  {:type :integer,
   :help "‌垂直同步间隔时间。设为 0 表示禁用此功能",
   :default 1,
   :label "同步间隔",
   :path ["display" "swap_interval"]}
  {:type :boolean,
   :help "垂直同步，依赖硬件垂直同步进行帧计时。具体实现可能因显卡驱动和平台差异而被覆盖。如需模拟已弃用的 'variable_dt' 行为，请取消勾选此设置并将帧上限设为 0 ",
   :default true,
   :label "垂直同步",
   :path ["display" "vsync"]}
  {:type :boolean
   :default false
   :deprecated true
   :severity-override :fatal
   :severity-default :warning
   :help "‌此设置已弃用。勾选后，将禁用垂直同步并将帧数上限设为 0 ，以实现等效的运行效果"
   :path ["display" "variable_dt"]}
  {:type :boolean,
   :help "在启动时将 GPU 信息输出到控制台",
   :default false,
   :label "显示硬件信息",
   :path ["display" "display_device_info"]}
  {:type :number,
   :help "渲染清除色 - 红色通道",
   :label "清除色红"
   :default 0,
   :minimum 0.0,
   :maximum 1.0,
   :path ["render" "clear_color_red"]}
  {:type :number,
   :help "渲染清除色 - 绿色通道",
   :label "清除色绿"
   :default 0,
   :minimum 0.0,
   :maximum 1.0,
   :path ["render" "clear_color_green"]}
  {:type :number,
   :help "渲染清除色 - 蓝色通道",
   :label "清除色蓝"
   :default 0,
   :minimum 0.0,
   :maximum 1.0,
   :path ["render" "clear_color_blue"]}
  {:type :number,
   :help "渲染清除色 - 透明通道",
   :label "清除色透明"
   :default 1.0,
   :minimum 0.0,
   :maximum 1.0,
   :path ["render" "clear_color_alpha"]}
  {:type :integer,
   :help "默认最多 128 个碰撞物体",
   :default 128,
   :label "最大碰撞对象数",
   :path ["physics" "max_collision_object_count"]}
  {:type :string,
   :help "‌使用何种物理系统：2D（默认）或3D",
   :default "2D",
   :label "类型",
   :path ["physics" "type"]
   :options [["2D" "2D"] ["3D" "3D"]]}
  {:type :boolean,
   :help "物理引擎是否采用固定时间步长，详见 engine.fixed_update_frequency",
   :default false,
   :label "使用固定时间步长",
   :path ["physics" "use_fixed_timestep"]}
  {:type :boolean,
   :help
   "‌可视化物理数据用于调试",
   :default false,
   :label "调试",
   :path ["physics" "debug"]}
  {:type :number,
   :help
   "‌可视化物理数据的透明度，范围 0 至 1，默认为 0.9",
   :default 0.9,
   :label "调试透明度",
   :path ["physics" "debug_alpha"]}
  {:type :number,
   :help
   "物理调试基准图元的绘制尺寸，默认为 30 单位",
   :default 30.0,
   :label "调试尺寸",
   :path ["physics" "debug_scale"]}
  {:type :integer,
   :help
   "最大并行物理世界数量，默认为 4 ，注意：该设置会显著增加内存占用",
   :default 4,
   :label "世界数量",
   :path ["physics" "world_count"]}
  {:type :number,
   :help "‌物理世界 X 轴方向的重力值，默认为 0",
   :default 0.0,
   :label "X 轴重力",
   :path ["physics" "gravity_x"]}
  {:type :number,
   :help
   "物理世界 Y 轴方向的重力值，默认为 -10，即自然重力值",
   :default -10.0,
   :label "Y 轴重力",
   :path ["physics" "gravity_y"]}
  {:type :number,
   :help "‌物理世界 Z 轴方向的重力值，默认为 0",
   :default 0.0,
   :label "Z 轴重力",
   :path ["physics" "gravity_z"]}
  {:type :number,
   :help
   "‌物理世界相对于游戏世界的缩放比例，用于提升数值精度，取值范围 0.01~1 ，默认为 1",
   :default 1.0,
   :label "缩放",
   :path ["physics" "scale"]}
  {:type :boolean,
   :help
   "若启用，允许设置动态刚体的缩放、位置及旋转，默认值为 true",
   :default true,
   :label "允许动态变换",
   :path ["physics" "allow_dynamic_transforms"]}
  {:type :integer,
   :help
   "脚本可接收的碰撞事件数量上限，默认为 64",
   :default 64,
   :label "最大碰撞值",
   :path ["physics" "max_collisions"]}
  {:type :integer,
   :help
   "‌脚本可接收的接触点数量上限，默认为 128，即碰撞发生时两个碰撞体之间的精确接触位置集合",
   :default 128,
   :label "最大触点值",
   :path ["physics" "max_contacts"]}
  {:type :number,
   :help "冲量低于此阈值的接触点不会上报至脚本，默认值 0 表示禁用过滤",
   :default 0.0,
   :label "接触冲量阈值",  ; 原配置已存在标签
   :path ["physics" "contact_impulse_limit"]}

  {:type :integer,
   :help "2D 物理系统每帧最大射线投射数量",
   :default 64,
   :label "2D 射线投射上限",  ; 原配置已存在标签
   :path ["physics" "ray_cast_limit_2d"]}

  {:type :integer,
   :help "3D 物理系统单帧最大射线投射数量",
   :default 128,
   :label "3D 射线投射上限",  ; 原配置已存在标签
   :path ["physics" "ray_cast_limit_3d"]}

  {:type :integer,
   :help "可检测的重叠触发器最大数量，默认为 16",
   :default 16,
   :label "触发器重叠容量上限",  ; 原配置已存在标签
   :path ["physics" "trigger_overlap_capacity"]}

  {:type :number,
   :help "导致弹性碰撞所需的最小速度阈值",  ; 优化翻译
   :default 1.0,
   :label "速度阈值",  ; 新增标签（基于 path 末级字段名）
   :path ["physics" "velocity_threshold"]}
 
  {:type :integer,
   :help "使用固定时间步长时模拟的最大步数（仅限 3D）",  ; 补充说明
   :default 2,
   :label "最大固定时间步",  ; 新增标签
   :path ["physics" "max_fixed_timesteps"]}
  
  {:type :string,
   :help "纹理缩小过滤的默认过滤方式，默认为线性过滤",
   :default "linear",
   :label "纹理缩小过滤方式",  ; 新增标签
   :path ["graphics" "default_texture_min_filter"]
   :options [["linear" "linear"]
             ["nearest" "nearest"]
             ["nearest_mipmap_nearest" "nearest mipmap nearest"]
             ["nearest_mipmap_linear" "nearest mipmap linear"]
             ["linear_mipmap_nearest" "linear mipmap nearest"]
             ["linear_mipmap_linear" "linear mipmap linear"]]}
  
  {:type :string,
   :help "纹理放大过滤的默认过滤方式，线性（默认）或邻近",
   :default "linear",
   :label "纹理放大过滤方式",  ; 新增标签
   :path ["graphics" "default_texture_mag_filter"]
   :options [["linear" "linear"] ["nearest" "nearest"]]}
  
  {:type :integer,
   :help "每帧最大绘制调用次数",
   :default 1024,
   :label "最大绘制调用数",  ; 新增标签
   :path ["graphics" "max_draw_calls"]}
  
  {:type :integer,
   :help "每帧可显示的最大字符数（文本）",
   :default 8192,
   :label "最大字符数",  ; 新增标签
   :path ["graphics" "max_characters"]}
  
  {:type :integer,
   :help "每帧可显示的最大文本批次数量",
   :default 128,
   :label "最大字体批次",  ; 新增标签
   :path ["graphics" "max_font_batches"]}
  
  {:type :integer,
   :help "调试顶点的最大数量（用于物理形状渲染等），默认为 10000",
   :default 10000,
   :label "最大调试顶点数",  ; 新增标签
   :path ["graphics" "max_debug_vertices"]}
  
  {:type :resource,
   :filter "texture_profiles",
   :preserve-extension true,
   :help "指定资源路径使用的纹理配置文件（格式、Mipmap和最大纹理尺寸）",
   :default "/builtins/graphics/default.texture_profiles",
   :label "纹理配置文件",  ; 新增标签（基于 path 末级字段名）
   :path ["graphics" "texture_profiles"]}
  
  {:type :boolean,
   :help "在每次图形调用后验证返回值",
   :default true,
   :label "验证图形调用",  ; 新增标签
   :path ["graphics" "verify_graphics_calls"]}
  
  {:type :string,
   :help "OpenGL 上下文版本提示。若指定版本，将作为最低要求版本（不适用于 OpenGL ES），默认为 OpenGL 3.3",
   :default "33",
   :path ["graphics" "opengl_version_hint"]
   :options [["33" "OpenGL 3.3"]
             ["40" "OpenGL 4.0"]
             ["41" "OpenGL 4.1"]
             ["42" "OpenGL 4.2"]
             ["43" "OpenGL 4.3"]
             ["44" "OpenGL 4.4"]
             ["45" "OpenGL 4.5"]
             ["46" "OpenGL 4.6"]
             ["0" "当前最高版本"]]}  ; 优化选项描述
  
  {:type :boolean,
   :help "创建上下文时设置 'core' OpenGL 配置提示。核心配置移除了OpenGL中所有过时功能（如即时渲染模式），不适用于OpenGL ES",
   :default true,
   :label "OpenGL核心配置提示",  ; 新增标签
   :path ["graphics" "opengl_core_profile_hint"]}
  
  {:type :boolean,
   :help "此设置已弃用。编译并输出SPIR-V着色器以供Metal或Vulkan使用",
   :default false,
   :deprecated true,
   :label "输出SPIR-V",  ; 原配置已存在标签
   :path ["shader" "output_spirv"]}
  
  {:type :number,
   :help "键盘按键持续按住后、开始重复触发前的等待时间（秒）",
