  {:type :resource,
   :filter "gamepads",
   :help "游戏手柄配置文件引用（将手柄信号映射到操作系统），默认为 /builtins/input/default.gamepads",
   :default "/builtins/input/default.gamepads",
   :label "手柄配置文件",  ; 新增标签
   :path ["input" "gamepads"]}
  
  {:type :resource,
   :filter "input_binding",
   :help "输入配置文件引用（将硬件输入映射到操作指令），默认为 /input/game.input_binding",
   :default "/input/game.input_binding",
   :label "输入绑定配置",  ; 新增标签
   :path ["input" "game_binding"]}
  
  {:type :boolean,
   :help "是否启用加速度计事件接收",
   :default true,
   :label "启用加速度计",  ; 新增标签
   :path ["input" "use_accelerometer"]}
  
  {:type :boolean,
   :help "使用HTTP缓存加速网络资源加载",
   :default false,
   :label "HTTP缓存",  ; 新增标签
   :path ["resource" "http_cache"]}
  
  {:type :string,
   :help "game.project文件位置（URI格式）",
   :default "",
   :label "项目文件URI",  ; 新增标签
   :path ["resource" "uri"]}
  
  {:type :integer,
   :help "可同时加载的最大资源数量，默认为1024",
